rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Hardened Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function hasTokenEmail() {
      return isSignedIn()
        && ('email' in request.auth.token)
        && (request.auth.token.email is string)
        && request.auth.token.email.size() > 0;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true && hasTokenEmail();
    }

    function isBootstrapAdmin() {
      return isVerifiedUser() && request.auth.token.email.lower() == 'yazanmohaamed070@gmail.com';
    }

    function isAdmin() {
      return isBootstrapAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isActive == true
      );
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidCatId(id) {
      return id is string && id.size() >= 2 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isKnownCategory(catId) {
      return catId in [
        'cat_general',
        'cat_science',
        'cat_history',
        'cat_arabic',
        'cat_puzzles',
        'cat_sports',
        'cat_islamic',
        'cat_prophet_stories',
        'cat_guess_price',
        'cat_rashidun',
        'jordan_brands_nostalgia',
        'cat_world_cup_2026',
        'cat_palestinian_proverbs',
        'cat_visual_memory',
        'cat_silent_acting'
      ] || exists(/databases/$(database)/documents/catalogCategories/$(catId));
    }

    // --- Validation Blueprints ---
    function isValidAdminRecord(data, adminUid) {
      return data.keys().hasAll(['uid', 'email', 'role', 'isActive', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'label', 'role', 'isActive', 'inviteId', 'assignedBy', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == adminUid && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && (!('label' in data) || (data.label is string && data.label.size() <= 80))
        && data.role is string && data.role in ['bootstrap_admin', 'controller']
        && data.isActive is bool
        && (!('inviteId' in data) || (data.inviteId is string && isValidId(data.inviteId)))
        && (!('assignedBy' in data) || (data.assignedBy is string && isValidId(data.assignedBy)))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidControllerInvite(data, inviteId) {
      return data.keys().hasAll(['id', 'email', 'isActive', 'invitedBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'email', 'label', 'isActive', 'activatedUid', 'invitedBy', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == inviteId && data.id.size() >= 2 && isValidId(data.id)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && (!('label' in data) || (data.label is string && data.label.size() <= 80))
        && data.isActive is bool
        && (!('activatedUid' in data) || (data.activatedUid is string && isValidId(data.activatedUid)))
        && data.invitedBy is string && isValidId(data.invitedBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCatalogCategory(data, categoryId) {
      return data.keys().hasAll([
          'id', 'name', 'description', 'iconKey', 'accentColor',
          'isVip', 'isActive', 'order', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'name', 'description', 'iconKey', 'accentColor',
          'isVip', 'isActive', 'order', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == categoryId && isValidCatId(data.id)
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 80
        && data.description is string && data.description.size() <= 280
        && data.iconKey is string && data.iconKey in [
          'general', 'science', 'history', 'arabic', 'puzzles',
          'sports', 'islamic', 'pdf', 'skills', 'geography', 'tech', 'price_tag', 'rashidun', 'jordan_logos', 'world_cup_2026', 'palestinian_proverbs', 'visual_memory', 'silent_acting'
        ]
        && data.accentColor is string && data.accentColor.size() >= 4 && data.accentColor.size() <= 16
        && data.accentColor.matches('^#[0-9a-fA-F]{3,8}$')
        && data.isVip is bool
        && data.isActive is bool
        && data.order is int && data.order >= 0 && data.order <= 10000
        && data.createdBy is string && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCatalogQuestion(data, questionId) {
      return data.keys().hasAll([
          'id', 'categoryId', 'categoryName', 'difficulty', 'points',
          'questionType', 'prompt', 'answer', 'status', 'isBackup',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'categoryId', 'categoryName', 'difficulty', 'points',
          'questionType', 'prompt', 'answer', 'acceptableAnswers', 'options',
          'correctOptionIndex', 'hint', 'explanation', 'imageUrl', 'imageCaption',
          'status', 'isBackup', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == questionId && data.id.size() >= 2 && data.id.size() <= 80 && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.categoryId is string && isValidCatId(data.categoryId)
        && data.categoryName is string && data.categoryName.size() >= 2 && data.categoryName.size() <= 80
        && data.difficulty is string && data.difficulty in ['easy', 'medium', 'hard']
        && data.points is int && data.points in [200, 400, 600]
        && data.questionType is string && data.questionType in [
          'direct_qa', 'complete', 'true_false_explain', 'who_am_i',
          'order_steps', 'spot_error', 'connect_two', 'buzzer_challenge',
          'analysis_reasoning', 'multiple_choice', 'pantomime_optional'
        ]
        && data.prompt is string && data.prompt.size() >= 3 && data.prompt.size() <= 800
        && data.answer is string && data.answer.size() >= 1 && data.answer.size() <= 500
        && (!('acceptableAnswers' in data) || (
          data.acceptableAnswers is list && data.acceptableAnswers.size() <= 10
          && (data.acceptableAnswers.size() == 0 || (data.acceptableAnswers[0] is string && data.acceptableAnswers[0].size() <= 200))
        ))
        && (!('options' in data) || (
          data.options is list && data.options.size() <= 6
          && (data.options.size() == 0 || (data.options[0] is string && data.options[0].size() <= 200))
        ))
        && (!('correctOptionIndex' in data) || (data.correctOptionIndex is int && data.correctOptionIndex >= 0 && data.correctOptionIndex <= 5))
        && (!('hint' in data) || (data.hint is string && data.hint.size() <= 300))
        && (!('explanation' in data) || (data.explanation is string && data.explanation.size() <= 600))
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 1000 && (data.imageUrl == '' || data.imageUrl.matches('^https?://.*') || data.imageUrl.matches('^/assets/.*') || data.imageUrl.matches('^/images/.*'))))
        && (!('imageCaption' in data) || (data.imageCaption is string && data.imageCaption.size() <= 200))
        && data.status is string && data.status in ['approved', 'needs_review', 'rejected']
        && data.isBackup is bool
        && data.createdBy is string && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'totalPlayedQuestions', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'totalPlayedQuestions', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() <= 120
        && data.email is string && data.email.size() <= 200
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 600))
        && data.totalPlayedQuestions is int && data.totalPlayedQuestions >= 0 && data.totalPlayedQuestions <= 1000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCategoryProgress(data, userId, categoryId) {
      return data.keys().hasAll(['userId', 'categoryId', 'playedQuestionIds', 'cycleCount', 'totalAnsweredAllTime', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'categoryId', 'playedQuestionIds', 'cycleCount', 'totalAnsweredAllTime', 'lastPlayedAt', 'lastResetAt', 'createdAt', 'updatedAt'])
        && data.userId is string && data.userId == userId && isValidId(data.userId)
        && data.categoryId is string && data.categoryId == categoryId && isValidCatId(data.categoryId)
        && data.playedQuestionIds is list && data.playedQuestionIds.size() <= 1000
        && (data.playedQuestionIds.size() == 0 || (data.playedQuestionIds[0] is string && data.playedQuestionIds[0].size() <= 128))
        && data.cycleCount is int && data.cycleCount >= 0 && data.cycleCount <= 100000
        && data.totalAnsweredAllTime is int && data.totalAnsweredAllTime >= 0 && data.totalAnsweredAllTime <= 1000000
        && (!('lastPlayedAt' in data) || data.lastPlayedAt is timestamp)
        && (!('lastResetAt' in data) || data.lastResetAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection: /admins/{adminUid} ---
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isOwner(adminUid) || isAdmin());
      allow list: if isBootstrapAdmin();
      allow create: if isVerifiedUser()
        && isValidId(adminUid)
        && isValidAdminRecord(incoming(), adminUid)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isBootstrapAdmin() ||
          (
            adminUid == request.auth.uid
            && incoming().role == 'controller'
            && incoming().isActive == true
            && incoming().email.lower() == request.auth.token.email.lower()
            && 'inviteId' in incoming()
            && exists(/databases/$(database)/documents/adminInvites/$(incoming().inviteId))
            && get(/databases/$(database)/documents/adminInvites/$(incoming().inviteId)).data.isActive == true
            && get(/databases/$(database)/documents/adminInvites/$(incoming().inviteId)).data.email.lower() == request.auth.token.email.lower()
          )
        );
      allow update: if isVerifiedUser()
        && isValidId(adminUid)
        && isValidAdminRecord(incoming(), adminUid)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isBootstrapAdmin() ||
          (
            isAdmin()
            && existing().role == 'controller'
            && incoming().role == 'controller'
            && incoming().diff(existing()).affectedKeys().hasOnly(['label', 'isActive', 'updatedAt'])
          )
        );
      allow delete: if isValidId(adminUid) && (isBootstrapAdmin() || (isAdmin() && existing().role == 'controller'));
    }

    // --- Collection: /adminInvites/{inviteId} ---
    match /adminInvites/{inviteId} {
      allow get: if isValidId(inviteId) && isVerifiedUser() && (
        existing().email.lower() == request.auth.token.email.lower() || isAdmin()
      );
      allow list: if isVerifiedUser() && (
        resource.data.email == request.auth.token.email.lower() ||
        resource.data.email == request.auth.token.email ||
        resource.data.invitedBy == request.auth.uid ||
        isBootstrapAdmin()
      );
      allow create: if isVerifiedUser()
        && isValidId(inviteId)
        && isValidControllerInvite(incoming(), inviteId)
        && incoming().invitedBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdmin();
      allow update: if isVerifiedUser()
        && isValidId(inviteId)
        && isValidControllerInvite(incoming(), inviteId)
        && incoming().id == existing().id
        && incoming().email == existing().email
        && incoming().invitedBy == existing().invitedBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['label', 'isActive', 'activatedUid', 'updatedAt'])) ||
          (
            existing().email.lower() == request.auth.token.email.lower()
            && existing().isActive == true
            && incoming().activatedUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['activatedUid', 'updatedAt'])
          )
        );
      allow delete: if isValidId(inviteId) && isAdmin();
    }

    // --- Collection: /catalogCategories/{categoryId} ---
    match /catalogCategories/{categoryId} {
      allow get: if isValidCatId(categoryId) && (existing().isActive == true || isAdmin());
      allow list: if resource.data.isActive == true || (isVerifiedUser() && resource.data.createdBy == request.auth.uid) || isBootstrapAdmin();
      allow create: if isVerifiedUser()
        && isValidCatId(categoryId)
        && isValidCatalogCategory(incoming(), categoryId)
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdmin();
      allow update: if isVerifiedUser()
        && isValidCatId(categoryId)
        && isValidCatalogCategory(incoming(), categoryId)
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'iconKey', 'accentColor', 'isVip', 'isActive', 'order', 'updatedAt'])
        && isAdmin();
      allow delete: if isValidCatId(categoryId) && isAdmin();
    }

    // --- Collection: /catalogQuestions/{questionId} ---
    match /catalogQuestions/{questionId} {
      allow get: if isValidId(questionId) && (existing().status == 'approved' || isAdmin());
      allow list: if resource.data.status == 'approved' || (isVerifiedUser() && resource.data.createdBy == request.auth.uid) || isBootstrapAdmin();
      allow create: if isVerifiedUser()
        && isValidId(questionId)
        && isValidCatalogQuestion(incoming(), questionId)
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isKnownCategory(incoming().categoryId)
        && isAdmin();
      allow update: if isVerifiedUser()
        && isValidId(questionId)
        && isValidCatalogQuestion(incoming(), questionId)
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'categoryId', 'categoryName', 'difficulty', 'points', 'questionType',
          'prompt', 'answer', 'acceptableAnswers', 'options', 'correctOptionIndex',
          'hint', 'explanation', 'imageUrl', 'imageCaption', 'status', 'isBackup', 'updatedAt'
        ])
        && isKnownCategory(incoming().categoryId)
        && isAdmin();
      allow delete: if isValidId(questionId) && isAdmin();
    }

    // --- Collection: /users/{userId} ---
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isBootstrapAdmin());
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().email.lower() == request.auth.token.email.lower()
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().email.lower() == request.auth.token.email.lower()
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'totalPlayedQuestions', 'updatedAt']);
      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());

      // --- Subcollection: /users/{userId}/categoryProgress/{categoryId} ---
      match /categoryProgress/{categoryId} {
        allow get: if isValidId(userId) && isValidCatId(categoryId) && (isOwner(userId) || isAdmin());
        allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isBootstrapAdmin());
        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidCatId(categoryId)
          && isValidCategoryProgress(incoming(), userId, categoryId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidCatId(categoryId)
          && isValidCategoryProgress(incoming(), userId, categoryId)
          && incoming().userId == existing().userId
          && incoming().categoryId == existing().categoryId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && (
            // Action: recordPlayed
            incoming().diff(existing()).affectedKeys().hasOnly(['playedQuestionIds', 'totalAnsweredAllTime', 'lastPlayedAt', 'updatedAt'])
            ||
            // Action: resetCycle
            incoming().diff(existing()).affectedKeys().hasOnly(['playedQuestionIds', 'cycleCount', 'lastResetAt', 'updatedAt'])
          );
        allow delete: if isValidId(userId) && isValidCatId(categoryId) && (isOwner(userId) || isAdmin());
      }
    }
  }
}
